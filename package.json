{
  "name": "math_mountain",
  "version": "0.1.0",
  "private": true,
  "os": [
    "!win32"
  ],
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start --tunnel",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "test": "jest",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "e2e": "maestro test .maestro/flows",
    "build:dev": "npx eas-cli build --profile development --platform all",
    "build:preview": "npx eas-cli build --profile preview --platform all",
    "build:production": "npx eas-cli build --profile production --platform all"
  },
  "dependencies": {
    "@expo-google-fonts/henny-penny": "^0.4.1",
    "@sentry/react-native": "^8.25.0",
    "expo": "~57.0.22",
    "expo-asset": "~57.0.17",
    "expo-constants": "~57.0.18",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.10",
    "babel-preset-expo": "~57.0.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "eslint-plugin-react-native-a11y": "^3.5.1",
    "globals": "^14.0.0",
    "jest": "^30.5.1",
    "jest-expo": "~57.0.5",
    "prettier": "^3.9.5",
    "typescript": "~6.0.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "@sentry/react-native"
      ]
    }
  },
  "overrides": {
    "eslint-plugin-react-native-a11y": {
      "eslint": "$eslint"
    }
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/.*|native-base|standard-navigation))"
    ],
    "collectCoverageFrom": [
      "{components,hooks,utils}/**/*.{ts,tsx}",
      "App.tsx",
      "app.config.js",
      "!**/__tests__/**"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 100,
        "branches": 100,
        "functions": 100,
        "lines": 100
      }
    }
  }
}
