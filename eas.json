{
  "cli": {
    "version": ">= 21.0.2",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview"
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "distribution": "internal"
    },
    "production-store": {
      "extends": "production",
      "distribution": "store",
      "android": {
        "buildType": "app-bundle"
      }
    }
  }
}
